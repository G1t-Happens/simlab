// TSConfig for modules that run in Node.js, via transpilation or type-stripping
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "playwright.config.*",
    "eslint.config.*"
  ],
  "compilerOptions": {
    // most tools transpile instead of using Node.js's native type-stripping, and bundler mode is
    // smoother to work with
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    // only the Node.js types, so no other `@types/*` packages get pulled in by accident
    "types": ["node"],

    // no output from `vue-tsc --build`, it only type-checks
    "noEmit": true,

    // `vue-tsc --build` writes a .tsbuildinfo file for incremental type-checking, kept out of the
    // root directory here
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
