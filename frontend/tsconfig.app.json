{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    // extra safety for array and object lookups, may have false positives
    "noUncheckedIndexedAccess": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    // `vue-tsc --build` writes a .tsbuildinfo file for incremental type-checking, kept out of the
    // root directory here
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
