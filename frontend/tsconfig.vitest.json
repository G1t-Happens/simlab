{
  "extends": "./tsconfig.app.json",

  // only the test files and no exclusions, app code the tests import comes in through module
  // resolution anyway
  "include": ["src/**/__tests__/*", "env.d.ts"],
  "exclude": [],

  "compilerOptions": {
    // Vitest runs in another environment than the app code, so lib and types differ
    "lib": [],
    "types": ["node", "jsdom"],

    // `vue-tsc --build` writes a .tsbuildinfo file for incremental type-checking, kept out of the
    // root directory here
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
