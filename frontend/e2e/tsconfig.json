{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["./**/*"],
  "compilerOptions": {
    // Playwright transpiles the tests itself, `vue-tsc --build` only type-checks them
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  }
}
